diff --git a/ptts/src/timestamp_attention.rs b/ptts/src/timestamp_attention.rs
new file mode 100644
index 0000000..e8cbb7b
--- /dev/null
+++ b/ptts/src/timestamp_attention.rs
@@ -0,0 +1,96 @@
+//! Optional selected-head attention capture. Disabled states keep the normal SDPA path.
+use xn::{Backend, Result, Tensor, TensorView, WithDTypeF};
+
+#[derive(Debug, Clone)]
+pub struct AttentionCapture {
+    heads: Vec<(usize, usize)>,
+    text_start: usize,
+    mapping: Vec<Vec<f32>>,
+    sum: Vec<f32>,
+    recorded: usize,
+}
+impl AttentionCapture {
+    /// Each token row contains its fractional overlap with the text units.
+    pub fn new(
+        heads: Vec<(usize, usize)>,
+        text_start: usize,
+        mapping: Vec<Vec<f32>>,
+    ) -> Result<Self> {
+        let units = mapping.first().map_or(0, Vec::len);
+        if heads.is_empty()
+            || mapping.is_empty()
+            || units == 0
+            || mapping
+                .iter()
+                .any(|r| r.len() != units || r.iter().any(|v| !v.is_finite() || *v < 0.0))
+            || heads.iter().enumerate().any(|(i, h)| heads[..i].contains(h))
+        {
+            xn::bail!("invalid timestamp attention configuration")
+        }
+        Ok(Self { heads, text_start, mapping, sum: vec![0.; units], recorded: 0 })
+    }
+    pub fn begin_frame(&mut self) {
+        self.sum.fill(0.);
+        self.recorded = 0;
+    }
+    pub fn finish_frame(&self) -> Result<Vec<f32>> {
+        if self.recorded != self.heads.len() {
+            xn::bail!("timestamp heads missing: {}/{}", self.recorded, self.heads.len())
+        }
+        Ok(self.sum.iter().map(|v| v / self.recorded as f32).collect())
+    }
+    pub fn capture<T: WithDTypeF, B: Backend>(
+        &mut self,
+        layer: usize,
+        q: &Tensor<T, B>,
+        k: &TensorView<T, B>,
+    ) -> Result<()> {
+        let selected: Vec<_> =
+            self.heads.iter().filter(|(l, _)| *l == layer).map(|(_, h)| *h).collect();
+        if selected.is_empty() {
+            return Ok(());
+        }
+        let (b, t, heads, d) = q.dims4()?;
+        if b != 1 || t != 1 || d == 0 {
+            xn::bail!("timestamps require single-stream decode")
+        }
+        let end = self.text_start + self.mapping.len();
+        if k.dims().len() != 4 || end > k.dims()[1] || selected.iter().any(|h| *h >= heads) {
+            xn::bail!("timestamp head or text range outside attention")
+        }
+        for head in selected {
+            // Read only the configured head and text keys, never the whole KV cache.
+            let query = q.narrow(2, head..head + 1)?.contiguous()?.to_vec()?;
+            let keys = k
+                .narrow(1, self.text_start..end)?
+                .narrow(2, head..head + 1)?
+                .contiguous()?
+                .to_vec()?;
+            let mut logits: Vec<f32> = keys
+                .chunks_exact(d)
+                .map(|key| {
+                    key.iter()
+                        .zip(&query)
+                        .map(|(a, b)| WithDTypeF::to_f32(*a) * WithDTypeF::to_f32(*b))
+                        .sum::<f32>()
+                        / (d as f32).sqrt()
+                })
+                .collect();
+            let max = logits.iter().copied().fold(f32::NEG_INFINITY, f32::max);
+            for x in &mut logits {
+                *x = (*x - max).exp();
+            }
+            let total: f32 = logits.iter().sum();
+            if !total.is_finite() || total <= 0. {
+                xn::bail!("non-finite timestamp attention")
+            }
+            for (prob, row) in logits.iter().zip(&self.mapping) {
+                for (sum, weight) in self.sum.iter_mut().zip(row) {
+                    *sum += prob / total * weight;
+                }
+            }
+            self.recorded += 1;
+        }
+        Ok(())
+    }
+}
